    <string name="help_p99_title">P99 GPU Frame Time</string>
    <string name="help_p99_what">Tiempo por debajo del cual se renderizó el 99% de los frames de GPU.</string>
    <string name="help_p99_why">Revela tirones que el promedio puede ocultar.</string>
    <string name="help_p99_how">Menor es mejor. Una diferencia inferior al 3% suele ser un empate técnico.</string>
    <string name="help_performance_title">Rendimiento gráfico</string>
    <string name="help_performance_what">Mide el tiempo de renderizado en workloads controlados y repetibles.</string>
    <string name="help_performance_why">Muestra si un controlador mejora la velocidad sin sacrificar la corrección.</string>
    <string name="help_performance_how">Puntuaciones mayores y tiempos menores son mejores, pero los gates de compatibilidad tienen prioridad.</string>
    <string name="help_compatibility_title">Índice de compatibilidad</string>
    <string name="help_compatibility_what">Resume corrección visual, formatos, shaders, sincronización, memoria, fiabilidad y soak.</string>
    <string name="help_compatibility_why">Un controlador más rápido no sirve si corrompe la imagen o falla en funciones obligatorias.</string>
    <string name="help_compatibility_how">100 es ideal. Cualquier gate obligatorio puede bloquear la recomendación.</string>
    <string name="help_thermal_title">Sostenimiento térmico</string>
    <string name="help_thermal_what">Mide el comportamiento del rendimiento y la temperatura bajo carga sostenida.</string>
    <string name="help_thermal_why">Los picos cortos pueden ocultar throttling y sesiones largas inestables.</string>
    <string name="help_thermal_how">Prefiere rendimiento estable con aumento térmico controlado en las mismas condiciones de refrigeración.</string>
