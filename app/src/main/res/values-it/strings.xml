    <string name="help_p99_title">P99 GPU Frame Time</string>
    <string name="help_p99_what">The time below which 99% of GPU frames were rendered.</string>
    <string name="help_p99_why">It exposes stutters that an average can hide.</string>
    <string name="help_p99_how">Lower is better. A difference below 3% is generally treated as a technical tie.</string>
    <string name="help_performance_title">Prestazioni grafiche</string>
    <string name="help_performance_what">Measures rendering time in controlled and repeatable workloads.</string>
    <string name="help_performance_why">It shows whether a driver improves speed without sacrificing correctness.</string>
    <string name="help_performance_how">Higher scores and lower times are better, but compatibility gates always take priority.</string>
    <string name="help_compatibility_title">Indice di compatibilità</string>
    <string name="help_compatibility_what">Summarizes visual correctness, formats, shaders, synchronization, memory, reliability and soak.</string>
    <string name="help_compatibility_why">A faster driver is not useful when it corrupts rendering or fails required features.</string>
    <string name="help_compatibility_how">100 is ideal. Any mandatory gate can block a recommendation regardless of performance.</string>
    <string name="help_thermal_title">Tenuta termica</string>
    <string name="help_thermal_what">Measures how performance and temperature behave during a sustained workload.</string>
    <string name="help_thermal_why">Short peaks can hide throttling and unstable long sessions.</string>
    <string name="help_thermal_how">Prefer stable performance with a controlled temperature increase under identical cooling conditions.</string>
